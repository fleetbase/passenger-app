# Copy to .env (git-ignored). Read at build time by scripts/link-brand.js.

# Your Fleetbase API. Android emulators reach this machine at 10.0.2.2; the app handles that.
PASSENGER_HOST=http://localhost:8000
# A public key from Fleet-Ops with the `rider` profile, which limits it to rider routes.
PASSENGER_KEY=

# Set to true to run on built-in sample data with no server. The app shows a banner when it's on.
PASSENGER_SAMPLE_DATA=false
